# Generated / large artifacts — not committed
# The factory populates security/ and specs/ at runtime.
# The pin file (if you use a benchmark dataset) is committed;
# the materialised payload blobs are not.
benchmarks/datasets/*
!benchmarks/datasets/.gitkeep

# Private keys and credential material
*.pem
*.p12
*.pfx
*.key
*_rsa
*_ed25519
*.private-key*
id_rsa*
