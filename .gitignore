# ── Factory runtime outputs — produced during a run, NEVER committed.
# Delivery stages the whole worktree (git add -A), so anything not listed
# here lands in the customer-facing PR diff.
test-results/
playwright-report/
.specify/feature.json

# ── Toolchain
node_modules/
.opencode/node_modules/
dist/
build/
coverage/
*.log

# ── Credentials — never in git, in any project, in any language.
.env
.env.*
!.env.example
*.pem
*.p12
*.key
id_rsa*
*.private-key*
